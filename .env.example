# ─── Database ───────────────────────────────────
DB_HOST=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_NAME=dulichdb
DB_PORT=3307

# ─── App ────────────────────────────────────────
PORT=6969
DOMAIN=http://127.0.0.1:6969
KEY_JWT=your_strong_jwt_secret

# ─── Gmail SMTP ─────────────────────────────────
# Use an App Password: https://support.google.com/accounts/answer/185833
GMAIL_FROM=your_email@gmail.com
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_PASS=xxxx xxxx xxxx xxxx

# ─── VNPay Payment Gateway ──────────────────────
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret

# ─── Google OAuth2 ──────────────────────────────
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Redis ──────────────────────────────────────
# Booking timeout: tự động hủy booking chưa thanh toán sau 10 phút
REDIS_URL=redis://127.0.0.1:6379
